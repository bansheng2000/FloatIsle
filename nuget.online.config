<?xml version="1.0" encoding="utf-8"?>
<!-- 只在「首次构建 / 清过 nuget 缓存 / 换机器」时用一次。用法见 README「首次构建要联网一次」
     （XML 注释里不能出现连续两个减号，所以命令行不写在这里）。
     日常构建不要用它：默认的 nuget.config 是清空源的离线配置。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
