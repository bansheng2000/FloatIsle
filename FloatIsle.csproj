<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8 的引用包本机是 8.0.33、SDK 8.0.427 要 8.0.31，离线还原拿不到，所以用 10（同为 LTS）。
         带 10.0.19041.0 这个 SDK 版本号是为了拿到 Windows.Media.Control（SMTC）的 WinRT 投影。
         该投影包 Microsoft.Windows.SDK.NET.Ref 不在本机 SDK 里：首次构建要联网还原一次（约 75MB），
         之后走全局缓存完全离线。见 README「首次构建要联网一次」。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用框架自带的 WinForms NotifyIcon，不引 NuGet -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FloatIsle</RootNamespace>
    <AssemblyName>FloatIsle</AssemblyName>
    <!-- Per-Monitor V2 声明在这里（<dpiAwareness>PerMonitorV2</dpiAwareness>），不是代码里 SetProcessDpiAwareness -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003：WinForms 分析器建议改用 ApplicationHighDpiMode，但那是 WinForms 单框架的做法；
         本程序是 WPF 主窗口 + 只借 WinForms 的托盘，DPI 必须走清单里的 PerMonitorV2，故关掉这条警告 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- 版本号唯一真相源：安装包的 AppVersion 从这里编译进 exe 的版本资源里读（installer/FloatIsle.iss） -->
    <Version>0.2.0</Version>
    <!-- exe 本体图标（资源管理器/任务栏）；托盘运行时从下面的嵌入资源按 DPI 选档，不依赖 exe 旁边的散文件 -->
    <ApplicationIcon>assets\floatisle.ico</ApplicationIcon>
    <!-- 默认会把 git 提交号拼进 ProductVersion（0.2.0+<sha>），安装包读到的版本就不干净了，关掉 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- 托盘图标的多尺寸 ico 作为嵌入资源打包：运行时按 DPI 从流里挑档，装到别的目录也不会丢 -->
  <ItemGroup>
    <EmbeddedResource Include="assets\floatisle.ico" />
  </ItemGroup>

</Project>
