<Window x:Class="FloatIsle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatIsle"
        Width="176" Height="60"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <!-- 外层不加 Background：透明区域不参与命中测试的一部分交给 Win32 层处理 -->
    <Grid Background="{x:Null}">
        <Border x:Name="Island"
                Width="160" Height="44"
                CornerRadius="22"
                Background="#A60E1014"
                BorderBrush="#3CFFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                MouseMove="Island_MouseMove"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <!-- 注意：窗口被 SetWindowRgn 裁成胶囊形状后，任何画在胶囊外的效果（阴影/外发光）都会被切掉，
                 所以这里不再用 DropShadowEffect。取舍写在 README「已知限制」。 -->
            <Grid>
                <!-- 假磨砂（系统 Acrylic 在「分层窗口 + 异形区域」上会糊满整个矩形，判不可用，见 README）：
                     65% 半透明底 + 内侧 1px 高光，全部画在胶囊形状内，区域外仍然全透明。
                     噪点纹理试过（烘进背景、32 DIP 平铺、1:1 直贴）：呼吸时 14–17 片/30 s，超 10 片预算，所以不做；
                     这条 1px 高光自己只占一层，删掉实测呼吸不变（见 README）。取舍写在 README「已知限制」。 -->
                <Rectangle x:Name="FrostHighlight" Margin="1" RadiusX="21" RadiusY="21"
                           Stroke="#26FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                <!-- 呼吸辉光 = 两层同心描边：外圈 7px（晕，Opacity 0.12↔0.55）+ 内层 3px（芯，0.85↔1.0）。
                     两层都画在胶囊内侧：窗口被 SetWindowRgn 裁成胶囊，画到形状外会被切掉，
                     所以外圈用 Margin 3.5 + 粗细 7 让它的外沿正好压在胶囊边缘（区域外仍全透明）。
                     只改两层 Opacity，不加 Effect.Blur（分层窗口下每帧成本会翻几倍，见 README）。 -->
                <Rectangle x:Name="GlowOuter"
                           Margin="3.5" RadiusX="18.5" RadiusY="18.5"
                           Stroke="#4DA3FF" StrokeThickness="7" Opacity="0"
                           Visibility="Collapsed" IsHitTestVisible="False" />
                <Rectangle x:Name="Glow"
                           Margin="1" RadiusX="21" RadiusY="21"
                           Stroke="#4DA3FF" StrokeThickness="3" Opacity="0"
                           Visibility="Collapsed" IsHitTestVisible="False" />
                <!-- 固定行网格（主行 / 副行 / 任务行×N / 提示行 / 状态行）：每行单行 + CharacterEllipsis，
                     行距 2 DIP，任意两行不重叠（UIA 矩形实测见 README）。必须用 Stretch 才会真的省略——
                     HorizontalAlignment=Center 时 TextBlock 按自然宽度排版，超长直接顶出胶囊外面。 -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
                      MaxWidth="280" Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 两行内容由 RefreshIslandText() 按「岛内容」模块顺序填：主行 14pt、副行 11pt。
                         收起时只留主行，展开时两行 + 状态行（见 Animate）。 -->
                    <TextBlock x:Name="Line1" Grid.Row="0" Text="FloatIsle"
                               Foreground="#F2FFFFFF" FontSize="14" FontWeight="SemiBold"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="Line2" Grid.Row="1" Text=""
                               Margin="0,2,0,0"
                               Foreground="#CCFFFFFF" FontSize="11"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center" HorizontalAlignment="Stretch" />
                    <!-- 任务区：展开时最多 4 行「工作区 · 状态」，行由 RefreshTaskRows() 生成（点一行 = 跳回会话） -->
                    <StackPanel x:Name="TaskRowsPanel" Grid.Row="2" Margin="0,2,0,0" Visibility="Collapsed" />
                    <!-- 插件给的失败原因（心跳 notice）与本地提示（跳转失败）：单行省略，
                         TextWrapping=Wrap 时两行会把状态行顶出胶囊（改前就是这么乱的）。 -->
                    <TextBlock x:Name="NoticeText" Grid.Row="3" Text=""
                               Margin="0,2,0,0"
                               Foreground="#E8B24D" FontSize="10"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Stretch" TextAlignment="Center" />
                    <TextBlock x:Name="StatusText" Grid.Row="4" Text="…"
                               Margin="0,2,0,0"
                               Foreground="#88FFFFFF" FontSize="10"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Stretch" TextAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- 贴顶工作台（Mode=top）：胶囊照常显示在窗口上沿，悬停胶囊（或光标贴工作区顶边 4 DIP）
             时向下长出这块卡片面板，上沿不动、只有下边变；离开就滑回去。
             面板接在胶囊下沿（Margin.Top 由 OpenTopWorkbench 按 WindowPadding 算，不留缝）。
             卡片由 RefreshTopTiles() 生成：顺序/开关来自设置，列数与宽度按内容自然宽度和
             工作区宽度自动推导（Placement.WorkbenchLayout，无固定列数）。 -->
        <Border x:Name="TopPanel"
                CornerRadius="16"
                Background="#F2101216"
                BorderBrush="#3CFFFFFF" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                MouseLeave="TopPanel_MouseLeave">
            <!-- 内边距固定 16（Placement.PanelPadding）：面板高 = 卡片网格高 + 32，没有固定最小高 -->
            <Grid x:Name="TopTiles" Margin="16"
                  MouseMove="TopTiles_MouseMove"
                  MouseLeftButtonUp="TopTiles_MouseLeftButtonUp"
                  LostMouseCapture="TopTiles_LostMouseCapture" />
        </Border>
    </Grid>
</Window>


