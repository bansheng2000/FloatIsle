<Window x:Class="FloatIsle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatIsle"
        Width="380" Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <!-- 外层不加 Background：透明区域不参与命中测试的一部分交给 Win32 层处理 -->
    <Grid Background="{x:Null}">
        <Border x:Name="Island"
                Width="160" Height="44"
                CornerRadius="22"
                Background="#E6101216"
                BorderBrush="#3CFFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                MouseMove="Island_MouseMove"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <!-- 注意：窗口被 SetWindowRgn 裁成胶囊形状后，任何画在胶囊外的效果（阴影/外发光）都会被切掉，
                 所以这里不再用 DropShadowEffect。取舍写在 README「已知限制」。 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280">
                <!-- 两行内容由 RefreshIslandText() 按「岛内容」模块顺序填：主行 14pt、副行 11pt。
                     收起时只留主行，展开时两行 + 状态行（见 Animate）。 -->
                <TextBlock x:Name="Line1" Text="FloatIsle"
                           Foreground="#F2FFFFFF" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Line2" Text=""
                           Margin="0,3,0,0"
                           Foreground="#CCFFFFFF" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <!-- 任务区：展开时最多 4 行「工作区 · 状态」，行由 RefreshTaskRows() 生成（点一行 = 跳回会话） -->
                <StackPanel x:Name="TaskRowsPanel" Margin="0,4,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="…"
                           Margin="0,4,0,0"
                           Foreground="#88FFFFFF" FontSize="10"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 贴顶工作台（Mode=top）：平时整窗隐藏，光标碰到屏幕顶边才从顶上滑下来。
             卡片由 RefreshTopTiles() 生成（用量 / 任务 / 媒体），两列 WrapPanel 自动换行。 -->
        <Border x:Name="TopPanel"
                Width="560"
                CornerRadius="16"
                Background="#F2101216"
                BorderBrush="#3CFFFFFF" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed"
                MouseLeave="TopPanel_MouseLeave">
            <StackPanel Margin="16">
                <!-- ItemWidth 264 = (560 - 两侧 16 - 列间距 12) / 2，两块正好一行 -->
                <WrapPanel x:Name="TopTiles" ItemWidth="264" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
