<Window x:Class="FloatIsle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatIsle"
        Width="176" Height="60"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <!-- 外层不加 Background：透明区域不参与命中测试的一部分交给 Win32 层处理 -->
    <Grid Background="{x:Null}">
        <Border x:Name="Island"
                Width="160" Height="44"
                CornerRadius="22"
                Background="#A60E1014"
                BorderBrush="#3CFFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                MouseMove="Island_MouseMove"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <!-- 注意：窗口被 SetWindowRgn 裁成胶囊形状后，任何画在胶囊外的效果（阴影/外发光）都会被切掉，
                 所以这里不再用 DropShadowEffect。取舍写在 README「已知限制」。 -->
            <Grid>
                <!-- 假磨砂（系统 Acrylic 在「分层窗口 + 异形区域」上会糊满整个矩形，判不可用，见 README）：
                     65% 半透明底 + 内侧 1px 高光，全部画在胶囊形状内，区域外仍然全透明。
                     噪点纹理试过（烘进背景、32 DIP 平铺、1:1 直贴）：呼吸时 14–17 片/30 s，超 10 片预算，所以不做；
                     这条 1px 高光自己只占一层，删掉实测呼吸不变（见 README）。取舍写在 README「已知限制」。 -->
                <Rectangle x:Name="FrostHighlight" Margin="1" RadiusX="21" RadiusY="21"
                           Stroke="#26FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                <!-- 呼吸辉光描边：铺满胶囊内侧（Margin 1 让开 1px 边框），只做装饰、不吃鼠标事件。
                     整圈同步明暗（动画只改这一条的 Opacity），粗细是 DIP、随 WPF 缩放。 -->
                <Rectangle x:Name="Glow"
                           Margin="1" RadiusX="21" RadiusY="21"
                           Stroke="#4DA3FF" StrokeThickness="3" Opacity="0"
                           Visibility="Collapsed" IsHitTestVisible="False" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280">
                <!-- 两行内容由 RefreshIslandText() 按「岛内容」模块顺序填：主行 14pt、副行 11pt。
                     收起时只留主行，展开时两行 + 状态行（见 Animate）。 -->
                <TextBlock x:Name="Line1" Text="FloatIsle"
                           Foreground="#F2FFFFFF" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="Line2" Text=""
                           Margin="0,3,0,0"
                           Foreground="#CCFFFFFF" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <!-- 任务区：展开时最多 4 行「工作区 · 状态」，行由 RefreshTaskRows() 生成（点一行 = 跳回会话） -->
                <StackPanel x:Name="TaskRowsPanel" Margin="0,4,0,0" Visibility="Collapsed" />
                <!-- 插件给的失败原因（心跳 notice），null 时下次心跳自动清掉 -->
                <TextBlock x:Name="NoticeText" Text=""
                           Margin="0,4,0,0"
                           Foreground="#E8B24D" FontSize="10"
                           TextWrapping="Wrap" MaxWidth="280"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           />
                <TextBlock x:Name="StatusText" Text="…"
                           Margin="0,4,0,0"
                           Foreground="#88FFFFFF" FontSize="10"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 贴顶工作台（Mode=top）：平时整窗隐藏，光标碰到屏幕顶边才从顶上滑下来。
             卡片由 RefreshTopTiles() 生成（用量 / 任务 / 媒体），两列 WrapPanel 自动换行。 -->
        <Border x:Name="TopPanel"
                Width="560"
                CornerRadius="16"
                Background="#F2101216"
                BorderBrush="#3CFFFFFF" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
               
                MouseLeave="TopPanel_MouseLeave">
            <StackPanel Margin="16">
                <!-- ItemWidth 264 = (560 - 两侧 16 - 列间距 12) / 2，两块正好一行 -->
                <WrapPanel x:Name="TopTiles" ItemWidth="264" />
            </StackPanel>
        </Border>
    </Grid>
</Window>


