<Window x:Class="FloatIsle.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatIsle 设置"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <!-- 普通窗口：有边框、能拖动、正常获得焦点。别加 WS_EX_NOACTIVATE / 别做穿透 -->
    <!-- 外面套 ScrollViewer：高缩放/小屏时窗口高度封顶（见 SettingsWindow.xaml.cs），内容进滚动条而不是被裁掉 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="透明度" FontWeight="SemiBold" />
        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                IsSnapToTickEnabled="True" Margin="0,4,0,2"
                ValueChanged="Opacity_Changed" />
        <TextBlock x:Name="OpacityValue" Foreground="#666666" FontSize="12" Margin="0,0,0,12" />

        <CheckBox x:Name="ClickThroughCheck" Content="启动时整窗点击穿透（热键仍可切换）"
                  Margin="0,0,0,8"
                  Checked="ClickThrough_Changed" Unchecked="ClickThrough_Changed" />
        <CheckBox x:Name="MediaCheck" Content="显示媒体信息（SMTC 只读）"
                  Margin="0,0,0,8"
                  Checked="Media_Changed" Unchecked="Media_Changed" />
        <CheckBox x:Name="FullscreenCheck" Content="全屏 / 锁屏时自动让位（隐藏岛）"
                  Margin="0,0,0,10"
                  Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed" />

        <Separator Margin="0,2,0,10" />
        <TextBlock Text="岛内容（从上到下就是显示顺序）" FontWeight="SemiBold" />
        <TextBlock x:Name="LedgerText" FontSize="12" Foreground="#666666"
                   TextWrapping="Wrap" Margin="0,4,0,4" />
        <!-- 行由 SettingsWindow.xaml.cs 的 RebuildModuleRows() 生成：显示开关 + 上移 + 下移（不做拖拽） -->
        <StackPanel x:Name="ModulesPanel" Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
            <TextBlock Text="收起时主行显示：" FontSize="12" VerticalAlignment="Center" />
            <ComboBox x:Name="CollapsedLineCombo" Width="150" Margin="8,0,0,0"
                      SelectionChanged="CollapsedLine_Changed" />
        </StackPanel>

        <Separator Margin="0,2,0,10" />
        <TextBlock Text="联动" FontWeight="SemiBold" />
        <TextBlock Text="接收地址（只绑 127.0.0.1；插件那边也要改成一样）" FontSize="12" Foreground="#666666"
                   TextWrapping="Wrap" Margin="0,2,0,4" />
        <TextBox x:Name="TasksEndpointBox" Width="230" HorizontalAlignment="Left"
                 TextChanged="TasksEndpoint_Changed" />
        <TextBlock Text="跳转地址（点任务行时 POST /jump 到这里；插件那边两个端口都要一致）"
                   FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,8,0,4" />
        <TextBox x:Name="TasksJumpBox" Width="230" HorizontalAlignment="Left"
                 TextChanged="TasksJump_Changed" />
        <TextBlock x:Name="TasksStatusText" FontSize="12" Foreground="#666666"
                   TextWrapping="Wrap" Margin="0,6,0,12" />

        <Separator Margin="0,2,0,10" />
        <TextBlock Text="悬停展开延迟" FontWeight="SemiBold" />
        <Slider x:Name="HoverSlider" Minimum="0" Maximum="1000" TickFrequency="50"
                IsSnapToTickEnabled="True" Margin="0,4,0,2"
                ValueChanged="Hover_Changed" />
        <TextBlock x:Name="HoverValue" Foreground="#666666" FontSize="12" Margin="0,0,0,12" />

        <TextBlock Text="位置" FontWeight="SemiBold" />
        <TextBlock x:Name="PlacementText" Foreground="#666666" FontSize="12"
                   TextWrapping="Wrap" Margin="0,2,0,6" />
        <Button x:Name="ResetPlacementButton" Content="复位到顶部居中"
                HorizontalAlignment="Left" Padding="10,4" Click="ResetPlacement_Click" />

        <Separator Margin="0,14,0,8" />
        <TextBlock x:Name="AutoStartText" Foreground="#666666" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="LoadWarning" Foreground="#B00020" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />

        <Button Content="关闭" HorizontalAlignment="Right" Padding="16,5"
                Margin="0,14,0,0" IsCancel="True" Click="Close_Click" />
    </StackPanel>
    </ScrollViewer>
</Window>
